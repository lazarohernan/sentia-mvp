{
  "name": "perks-ops-agent",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-06-11",
  "durable_objects": {
    "bindings": [
      {
        "name": "PERKS_OPS_AGENT",
        "class_name": "PerksOpsAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PerksOpsAgent"]
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.4-mini",
    "APP_BASE_URL": "http://localhost:3000"
  }
}
